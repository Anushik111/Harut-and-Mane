<script>

/* =====================================================
   LANGUAGE
===================================================== */

let currentLanguage = "hy";

function setLanguage(lang){

    currentLanguage = lang;

    document.documentElement.lang = lang;

    document.querySelectorAll("[data-hy]").forEach(function(element){

        element.textContent = element.getAttribute("data-" + lang);

    });

    document.getElementById("introHy").classList.toggle("active",lang === "hy");
    document.getElementById("introRu").classList.toggle("active",lang === "ru");

    document.getElementById("mainHy").classList.toggle("active",lang === "hy");
    document.getElementById("mainRu").classList.toggle("active",lang === "ru");

    /* Translate RSVP select options */
    document.querySelectorAll(".rsvp-form option[data-" + lang + "]").forEach(function(option){
        option.textContent = option.getAttribute("data-" + lang);
    });

    /* Translate RSVP placeholders */
    document.querySelectorAll(".rsvp-form input[data-placeholder-" + lang + "]").forEach(function(input){
        input.placeholder = input.getAttribute("data-placeholder-" + lang);
    });

    /* wax seal */
    const seal = document.querySelector(".wax-seal");

    if(lang === "hy"){
        seal.textContent = "Հ & Մ";
    }else{
        seal.textContent = "А & М";
    }
}


/* =====================================================
   ENVELOPE
===================================================== */

const envelope = document.getElementById("envelope");
const intro = document.getElementById("intro");
const main = document.getElementById("main");
let opened = false;

function openInvitation(){
    if(opened) return;
    opened = true;
    envelope.classList.add("open");
    setTimeout(function(){
        intro.classList.add("hide");
        main.classList.add("show");
        window.scrollTo(0,0);
    },1550);
}

envelope.addEventListener("click", openInvitation);
envelope.addEventListener("keydown", function(e){
    if(e.key === "Enter" || e.key === " "){
        e.preventDefault();
        openInvitation();
    }
});

</script>

