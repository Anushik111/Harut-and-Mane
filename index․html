<!DOCTYPE html>
<html lang="hy">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Հարութ & Մանե | Wedding Invitation</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bad+Script&family=Cormorant+Garamond:wght@400;500;600&family=Noto+Serif+Armenian:wght@400;500;600&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#eee5d9;
    color:#4d3632;
    overflow-x:hidden;
    overflow-y:auto;
}

/* =====================================================
   INTRO
===================================================== */

.intro{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#e5e5e5;
    transition:opacity 1.3s ease, visibility 1.3s ease;
    overflow:hidden;
}

.intro.hide{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}

/* language */

.language{
    position:absolute;
    top:25px;
    right:25px;
    z-index:20;
    display:flex;
    align-items:center;
    gap:7px;
    font-family:'Noto Serif Armenian',serif;
    font-size:12px;
    letter-spacing:1px;
}

.language button{
    border:0;
    background:none;
    color:#76504a;
    cursor:pointer;
    font-size:12px;
    font-family:inherit;
    padding:5px;
}

.language button.active{
    color:#762f36;
    font-weight:600;
}

.language span{
    color:#b89b8c;
}

/* envelope scene */

.envelope-scene{
    width:min(92vw,650px);
    text-align:center;
}

.envelope-shadow{
    position:absolute;
    width:min(76vw,500px);
    height:45px;
    background:rgba(65,35,29,.16);
    filter:blur(22px);
    border-radius:50%;
    bottom:17%;
    left:50%;
    transform:translateX(-50%);
}

/* REAL ENVELOPE */

.envelope{
    position:relative;
    width:min(88vw,560px);
    height:min(58vw,360px);
    max-height:360px;
    min-height:245px;
    margin:auto;
    cursor:pointer;
    filter:drop-shadow(0 25px 25px rgba(60,35,30,.14));
    perspective:1500px;
}

/* paper */

.envelope-paper{
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,rgba(120,80,60,.025) 1px,transparent 1px),
        linear-gradient(rgba(120,80,60,.02) 1px,transparent 1px),
        #f8f0e5;
    background-size:7px 7px;
    border:1px solid rgba(92,59,50,.12);
    border-radius:3px;
    overflow:hidden;
}

/* inner paper */

.invitation-paper{
    position:absolute;
    width:76%;
    height:88%;
    left:12%;
    top:8%;
    background:#fffaf3;
    box-shadow:0 4px 18px rgba(60,35,30,.13);
    z-index:2;
    transition:
        transform 1.5s cubic-bezier(.77,0,.18,1),
        top 1.5s cubic-bezier(.77,0,.18,1);
    display:flex;
    align-items:center;
    justify-content:center;
}

.envelope.open .invitation-paper{
    transform:translateY(-60%);
    top:0;
}

.paper-inner{
    text-align:center;
    color:#762f36;
}

.paper-small{
    font-family:'Bad Script',cursive;
    font-size:18px;
}

.paper-names{
    font-family:'Bad Script',cursive;
    font-size:30px;
    margin-top:8px;
}

/* envelope bottom folds */

.fold-left{
    position:absolute;
    bottom:0;
    left:0;
    width:52%;
    height:76%;
    background:#eee0cf;
    clip-path:polygon(0 0,100% 100%,0 100%);
    z-index:4;
    border-top:1px solid rgba(100,60,50,.08);
}

.fold-right{
    position:absolute;
    bottom:0;
    right:0;
    width:52%;
    height:76%;
    background:#e9dac8;
    clip-path:polygon(100% 0,100% 100%,0 100%);
    z-index:4;
    border-top:1px solid rgba(100,60,50,.08);
}

/* top flap */

.flap{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:67%;
    background:
        linear-gradient(145deg,#f7ecdd,#edddcb);
    clip-path:polygon(0 0,100% 0,50% 100%);
    transform-origin:top center;
    z-index:8;
    transition:transform 1.45s cubic-bezier(.77,0,.18,1);
    filter:drop-shadow(0 2px 2px rgba(70,40,35,.06));
}

.envelope.open .flap{
    transform:rotateX(180deg);
}

/* envelope decorative line */

.envelope-line{
    position:absolute;
    left:12%;
    right:12%;
    top:20%;
    height:1px;
    background:rgba(126,77,67,.15);
    z-index:7;
}

/* wax seal */

.wax-seal{
    position:absolute;
    z-index:20;
    width:82px;
    height:82px;
    border-radius:50%;
    left:50%;
    top:53%;
    transform:translate(-50%,-50%);
    background:
        radial-gradient(circle at 35% 30%,#a95858,#762d34 60%,#61242b);
    box-shadow:
        0 5px 12px rgba(65,25,25,.22),
        inset 2px 2px 5px rgba(255,255,255,.12);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#f6dfd0;
    font-family:'Bad Script',cursive;
    font-size:26px;
    transition:
        opacity .45s ease,
        transform .6s ease;
}

.wax-seal:before{
    content:"";
    position:absolute;
    inset:8px;
    border:1px solid rgba(255,230,220,.28);
    border-radius:50%;
}

.envelope.open .wax-seal{
    opacity:0;
    transform:translate(-50%,-50%) scale(.6);
}

/* little paper decoration */

.corner-flower{
    position:absolute;
    z-index:9;
    color:#8b5a52;
    font-size:25px;
    opacity:.55;
}

.corner-flower.one{
    top:22px;
    left:25px;
    transform:rotate(-25deg);
}

.corner-flower.two{
    bottom:20px;
    right:25px;
    transform:rotate(150deg);
}

.open-hint{
    margin-top:35px;
    font-family:'Bad Script',cursive;
    font-size:25px;
    color:#754b46;
    animation:breathe 2.5s infinite;
}

@keyframes breathe{
    0%,100%{opacity:.55}
    50%{opacity:1}
}


/* =====================================================
   MAIN
===================================================== */

.main{
    position:relative;
    z-index:1;
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transition:opacity 1.2s ease, visibility 0s linear 1.2s;
}

.main.show{
    opacity:1;
    visibility:visible;
    pointer-events:auto;
    transition:opacity 1.2s ease;
}

.main-language{
    position:fixed;
    top:20px;
    right:20px;
    z-index:100;
    background:rgba(255,250,243,.85);
    backdrop-filter:blur(8px);
    padding:7px 11px;
    border-radius:30px;
    box-shadow:0 4px 15px rgba(60,35,30,.08);
}

/* hero */

.hero{
    min-height:100vh;
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    background:
        radial-gradient(circle at 15% 15%,rgba(130,64,57,.07),transparent 25%),
        radial-gradient(circle at 85% 85%,rgba(130,64,57,.07),transparent 25%),
        #f5eee5;
    overflow:hidden;
}

.hero-content{
    padding:50px 25px;
    position:relative;
    z-index:3;
}

.pre-title{
    font-family:'Bad Script',cursive;
    font-size:25px;
    color:#82534d;
    margin-bottom:15px;
}

.names{
    font-family:'Bad Script',cursive;
    color:#762f36;
    font-size:clamp(60px,12vw,110px);
    line-height:1.05;
}

.amp{
    font-family:'Cormorant Garamond',serif;
    font-size:.48em;
    margin:0 10px;
}

.date{
    margin-top:28px;
    font-family:'Cormorant Garamond',serif;
    letter-spacing:7px;
    font-size:25px;
    color:#5d403c;
}

.decor-line{
    width:75px;
    height:1px;
    margin:27px auto;
    background:#a37a6d;
}

.hero-text{
    font-family:'Noto Serif Armenian',serif;
    max-width:580px;
    margin:auto;
    font-size:17px;
    line-height:2;
    color:#614a46;
}

/* leaves */

.leaf{
    position:absolute;
    width:17px;
    height:28px;
    background:#895049;
    opacity:.28;
    border-radius:100% 0 100% 0;
    animation:fall 12s linear infinite;
}

.leaf:nth-child(1){left:7%;animation-delay:-2s}
.leaf:nth-child(2){left:18%;animation-delay:-8s}
.leaf:nth-child(3){left:31%;animation-delay:-4s}
.leaf:nth-child(4){left:51%;animation-delay:-10s}
.leaf:nth-child(5){left:70%;animation-delay:-5s}
.leaf:nth-child(6){left:87%;animation-delay:-7s}

@keyframes fall{
    from{
        top:-10%;
        transform:rotate(0deg) translateX(0);
    }
    to{
        top:110%;
        transform:rotate(360deg) translateX(-80px);
    }
}

/* sections */

.section{
    min-height:75vh;
    padding:100px 25px;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
}

.section-inner{
    width:min(900px,100%);
}

.section-title{
    font-family:'Bad Script',cursive;
    color:#762f36;
    font-size:53px;
    margin-bottom:25px;
}

.section-text{
    font-family:'Noto Serif Armenian',serif;
    font-size:18px;
    line-height:2;
    color:#604844;
}

/* date */

.date-section{
    background:#e9ded1;
}

.date-card{
    width:min(470px,100%);
    margin:auto;
    background:#fffaf3;
    padding:65px 35px;
    position:relative;
    box-shadow:0 18px 45px rgba(70,35,30,.09);
}

.date-card:before{
    content:"";
    position:absolute;
    inset:13px;
    border:1px solid rgba(119,53,53,.16);
    pointer-events:none;
}

.date-number{
    font-family:'Bad Script',cursive;
    color:#762f36;
    font-size:105px;
    line-height:.9;
}

.month{
    margin-top:20px;
    font-family:'Noto Serif Armenian',serif;
    letter-spacing:5px;
    font-size:20px;
}

.year{
    margin-top:8px;
    letter-spacing:5px;
    font-size:19px;
}

/* details */

.details{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
    margin-top:45px;
}

.detail{
    background:#fffaf3;
    padding:40px 25px;
    box-shadow:0 10px 30px rgba(70,35,30,.06);
}

.detail-icon{
    font-size:28px;
    color:#762f36;
    margin-bottom:12px;
}

.detail h3{
    font-family:'Bad Script',cursive;
    color:#762f36;
    font-size:30px;
    margin-bottom:12px;
}

.detail p{
    font-family:'Noto Serif Armenian',serif;
    font-size:16px;
    line-height:1.9;
}

/* RSVP */

.rsvp{
    background:#762f36;
}

.rsvp .section-title{
    color:#fff1e7;
}

.rsvp .section-text{
    color:#f8e9df;
    margin-bottom:28px;
}

.rsvp-form{
    width:min(520px,100%);
    margin:0 auto;
    padding:30px;
    background:rgba(255,250,243,.10);
    border:1px solid rgba(255,239,226,.35);
    text-align:left;
    backdrop-filter:blur(5px);
}

.rsvp-field{
    margin-bottom:18px;
}

.rsvp-field label{
    display:block;
    margin-bottom:8px;
    color:#fff4ea;
    font-family:'Noto Serif Armenian',serif;
    font-size:14px;
}

.rsvp-field input,
.rsvp-field select{
    width:100%;
    padding:13px 14px;
    border:1px solid rgba(255,239,226,.55);
    background:#fffaf3;
    color:#4d3632;
    outline:none;
    font-family:'Noto Serif Armenian',serif;
    font-size:15px;
}

.rsvp-field input:focus,
.rsvp-field select:focus{
    border-color:#fff;
}

.rsvp-submit{
    width:100%;
    margin-top:8px;
    padding:14px 20px;
    border:1px solid #e8cfc0;
    background:transparent;
    color:#fff4ea;
    cursor:pointer;
    font-family:'Noto Serif Armenian',serif;
    font-size:15px;
    transition:.3s;
}

.rsvp-submit:hover{
    background:#fff4ea;
    color:#762f36;
}

.rsvp-note{
    margin-top:14px;
    color:#f8e9df;
    text-align:center;
    font-family:'Noto Serif Armenian',serif;
    font-size:12px;
    opacity:.85;
}

/* footer */

.footer{
    background:#f5eee5;
    text-align:center;
    padding:75px 20px;
}

.footer-names{
    font-family:'Bad Script',cursive;
    font-size:52px;
    color:#762f36;
}

.footer-date{
    margin-top:15px;
    letter-spacing:4px;
}

/* mobile */

@media(max-width:650px){

    .envelope{
        width:90vw;
        height:58vw;
        min-height:220px;
    }

    .wax-seal{
        width:68px;
        height:68px;
        font-size:22px;
    }

    .open-hint{
        font-size:22px;
    }

    .names{
        font-size:62px;
    }

    .date{
        font-size:20px;
        letter-spacing:4px;
    }

    .details{
        grid-template-columns:1fr;
    }

    .section-title{
        font-size:44px;
    }

    .date-number{
        font-size:88px;
    }

    .rsvp-form{
        padding:22px 18px;
    }
}

/* =====================================================
   REALISTIC ENVELOPE
===================================================== */
.intro{min-height:100vh;display:flex;align-items:center;justify-content:center;position:fixed;inset:0;z-index:9999;overflow:hidden}
.envelope-wrap{width:min(760px,92vw);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;perspective:1400px}
.envelope{position:relative;width:min(620px,88vw);aspect-ratio:1.58/1;cursor:pointer;outline:none;transform-style:preserve-3d;transition:transform .45s ease}
.envelope:hover{transform:translateY(-7px)}
.envelope:focus-visible{outline:2px solid rgba(137,91,63,.5);outline-offset:12px;border-radius:8px}
.env-shadow{position:absolute;left:4%;right:4%;bottom:-10%;height:18%;background:rgba(65,44,31,.20);filter:blur(24px);border-radius:50%;z-index:0}
.env-body{position:absolute;inset:0;overflow:visible;transform-style:preserve-3d}
.env-back{position:absolute;inset:0;border-radius:7px;background:linear-gradient(135deg,rgba(255,255,255,.55),transparent 30%),linear-gradient(180deg,#f6efe4,#e8dac8);box-shadow:0 20px 45px rgba(73,50,34,.18),inset 0 0 0 1px rgba(118,83,55,.16);z-index:1}
.letter{position:absolute;left:9%;right:9%;top:8%;height:82%;background:linear-gradient(180deg,#fffdf8,#f6efe4);box-shadow:0 5px 16px rgba(72,49,32,.15);z-index:2;transform:translateY(7%);transition:transform 1.15s cubic-bezier(.18,.82,.22,1)}
.letter-border{position:absolute;inset:12px;border:1px solid rgba(143,103,70,.24);display:flex;flex-direction:column;align-items:center;justify-content:center}
.letter-kicker{font-size:11px;letter-spacing:3px;color:#8b6a4d}
.letter-names{margin-top:18px;color:#49362c;font-family:'Cormorant Garamond',serif;font-size:clamp(32px,5vw,50px);font-style:italic}
.letter-names span{font-size:.65em;margin:0 8px;color:#9b7551}
.letter-line{width:75px;height:1px;margin-top:18px;background:#b7956e}
.env-left,.env-right,.env-bottom{position:absolute;z-index:5;pointer-events:none}
.env-left{inset:0 auto 0 0;width:58%;clip-path:polygon(0 0,100% 50%,0 100%);background:linear-gradient(135deg,#eee2d3,#d9c7b2);filter:drop-shadow(3px 0 3px rgba(72,48,31,.10))}
.env-right{inset:0 0 0 auto;width:58%;clip-path:polygon(100% 0,0 50%,100% 100%);background:linear-gradient(225deg,#eee2d3,#d9c7b2);filter:drop-shadow(-3px 0 3px rgba(72,48,31,.10))}
.env-bottom{left:0;right:0;bottom:0;height:57%;clip-path:polygon(0 100%,50% 0,100% 100%);background:linear-gradient(180deg,#e6d6c3,#cfbba3);filter:drop-shadow(0 -3px 3px rgba(72,48,31,.11))}
.env-flap{position:absolute;top:0;left:0;width:100%;height:57%;z-index:8;transform-origin:50% 0%;transform-style:preserve-3d;transition:transform 1.2s cubic-bezier(.2,.78,.18,1);clip-path:polygon(0 0,100% 0,50% 100%);background:linear-gradient(180deg,#f6ede1,#dfccb7);filter:drop-shadow(0 4px 4px rgba(69,45,29,.12))}
.flap-inner{position:absolute;inset:1px;clip-path:polygon(0 0,100% 0,50% 96%);background:linear-gradient(180deg,#fffaf2,#e7d7c5)}
.seal{position:absolute;z-index:12;left:50%;top:50%;width:84px;height:84px;transform:translate(-50%,-50%);border-radius:50%;display:flex;align-items:center;justify-content:center;gap:3px;color:#f7eadb;font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:1px;background:radial-gradient(circle at 35% 28%,#a65a56,#853b3b 34%,#68282d 72%,#4e1d22);border:4px solid rgba(91,42,38,.22);box-shadow:0 6px 13px rgba(52,26,23,.25),inset 4px 4px 7px rgba(255,255,255,.15),inset -5px -5px 8px rgba(36,12,14,.20);transition:transform .7s ease,opacity .4s ease}
.seal:before{content:"";position:absolute;inset:-7px;border-radius:50%;border:1px solid rgba(117,74,52,.25)}
.seal b{font-size:14px;font-weight:400}
.open-hint{color:#6f5546;font-family:'Bad Script',cursive;font-size:21px;opacity:.9;animation:hintPulse 2.5s ease-in-out infinite}
@keyframes hintPulse{0%,100%{opacity:.55;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}
.envelope.open{transform:translateY(18px) scale(.99)}
.envelope.open .env-flap{transform:rotateX(180deg)}
.envelope.open .seal{transform:translate(-50%,-50%) scale(.72);opacity:0}
.envelope.open .letter{transform:translateY(-43%);transition-delay:.35s}
.envelope.open .env-left,.envelope.open .env-right,.envelope.open .env-bottom{transition:opacity .55s ease .7s;opacity:.16}
.intro.hide{opacity:0;pointer-events:none;transition:opacity .75s ease .65s}
.main.show{display:block}
@media(max-width:650px){.envelope-wrap{gap:20px}.envelope{width:91vw}.seal{width:68px;height:68px;font-size:18px}.letter-kicker{font-size:8px;letter-spacing:2px}.letter-names{font-size:30px}.open-hint{font-size:18px}}
/* USER SUPPLIED FABRIC BACKGROUND */
html,body{
    background-image:url("data:image/jpeg;base64,");
    background-size:cover;
    background-position:center;
    background-attachment:fixed;
    background-repeat:no-repeat;
}
body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-1;
    background:url("data:image/jpeg;base64,") center/cover no-repeat;
}
.intro,
.hero,
.date-section,
.footer{
    background-image:url("data:image/jpeg;base64,") !important;
    background-size:cover !important;
    background-position:center !important;
}
.main{background:transparent;}
@media(max-width:650px){
    html,body,body::before,.intro,.hero,.date-section,.footer{
        background-attachment:scroll;
    }
}
</style>
</head>

<body>

<!-- =====================================================
     ENVELOPE INTRO
===================================================== -->

<div class="intro" id="intro">
    <div class="language">
        <button id="introHy" class="active" onclick="setLanguage('hy')">ՀԱՅ</button>
        <span>|</span>
        <button id="introRu" onclick="setLanguage('ru')">РУС</button>
    </div>

    <div class="envelope-wrap">
    <div class="envelope" id="envelope" role="button" tabindex="0" aria-label="Բացել հրավիրատոմսը">
        <div class="env-shadow"></div>
        <div class="env-body">
            <div class="env-back"></div>

            <div class="letter">
                <div class="letter-border">
                    <div class="letter-kicker" data-hy="ՀԱՐՍԱՆԵԿԱՆ ՀՐԱՎԻՐԱՏՈՄՍ" data-ru="СВАДЕБНОЕ ПРИГЛАШЕНИЕ">ՀԱՐՍԱՆԵԿԱՆ ՀՐԱՎԻՐԱՏՈՄՍ</div>
                    <div class="letter-names">Հարութ <span>&amp;</span> Մանե</div>
                    <div class="letter-line"></div>
                </div>
            </div>

            <div class="env-left"></div>
            <div class="env-right"></div>
            <div class="env-bottom"></div>
            <div class="env-flap"><div class="flap-inner"></div></div>

            <div class="seal"><span>H</span><b>&amp;</b><span>M</span></div>
        </div>
    </div>
    <div class="open-hint" data-hy="Սեղմեք ծրարի վրա՝ բացելու համար" data-ru="Нажмите на конверт, чтобы открыть">Սեղմեք ծրարի վրա՝ բացելու համար</div>
</div>
</div>

<!-- =====================================================
     MAIN
===================================================== -->

<div class="main" id="main">

    <div class="language main-language">
        <button id="mainHy" class="active" onclick="setLanguage('hy')">ՀԱՅ</button>
        <span>|</span>
        <button id="mainRu" onclick="setLanguage('ru')">РУС</button>
    </div>


    <!-- HERO -->

    <section class="hero">

        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
